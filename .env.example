# ================================================
# Mobile Morocco Platform - Environment Variables
# ================================================
# Copy this file to .env and fill in your values
# 
# IMPORTANT: The app will NOT start without the required variables.
# If you see a "Configuration Error" page, check these values.
#
# For Tempo platform users: These are automatically configured.
# For external deployments: Set in your hosting provider's dashboard.

# ===========================
# REQUIRED - Supabase Configuration (MUST be set)
# ===========================
# Your Supabase project URL (from Supabase dashboard > Settings > API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Your Supabase anonymous/public key (from Supabase dashboard > Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================
# OPTIONAL - Application Settings
# ===========================
# Application environment (development, production, test)
# Default: production
VITE_APP_ENV=development

# Base URL for the application (usually "/" for root deployment)
# Default: /
VITE_BASE_URL=/

# ===========================
# OPTIONAL - Ad Request Email Configuration
# ===========================
# Admin email to receive ad requests
VITE_ADMIN_ADS_EMAIL=admin@example.com

# From email address for sending ad requests (optional)
VITE_FROM_EMAIL=noreply@mobilemorocco.com

# Resend API key for sending emails (optional, falls back to mailto if not set)
VITE_RESEND_API_KEY=re_your_resend_api_key_here

# ===========================
# SERVER-SIDE ONLY (For migrations, edge functions, etc.)
# These are NOT exposed to the browser - keep them secret!
# Set these in Tempo or your hosting provider, never commit actual values
# ===========================
# SUPABASE_PROJECT_ID=your-project-id
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_KEY=your-service-key-here (NEVER expose this to frontend!)

# ===========================
# Deployment Checklist
# ===========================
# 1. Set VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY in your hosting dashboard
# 2. Run: npm run deploy:check (must pass before deployment)
# 3. If using Hostinger/Apache: public/.htaccess handles SPA routing
# 4. If using Vercel/Netlify: vercel.json or public/_redirects handle routing
# 5. Test: Visit /phones directly to ensure SPA routing works
